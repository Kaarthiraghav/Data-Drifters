    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# IMPROVEMENT 3: Marketing Budget Optimizer — LKR 5M across Western Province\n",
    "# Tier 1 (60%): High potential gap outlets\n",
    "# Tier 2 (20%): High population density outlets\n",
    "# Tier 3 (20%): High seasonality / holiday outlets\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "print(f\"\\n{'='*70}\\nIMPROVEMENT 3: Marketing Budget Optimizer\\n{'='*70}\")\n",
    "\n",
    "from scipy.optimize import linprog\n",
    "import pandas as pd\n",
    "\n",
    "def optimize_marketing_budget(\n",
    "    predictions_df,\n",
    "    outlet_master_df,\n",
    "    total_budget=5_000_000,\n",
    "    min_spend=0,\n",
    "    max_spend=200_000,\n",
    "):\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(\"MARKETING BUDGET OPTIMIZER — Western Province\")\n",
    "    print(f\"{'='*60}\")\n",
    "\n",
    "    western_distributors = ['DIST_W_01', 'DIST_W_02', 'DIST_W_03']\n",
    "\n",
    "    western = predictions_df.merge(\n",
    "        outlet_master_df[['Outlet_ID', 'Distributor_ID']],\n",
    "        on='Outlet_ID', how='left'\n",
    "    )\n",
    "    western = western[western['Distributor_ID'].isin(western_distributors)].copy()\n",
    "    western = western.reset_index(drop=True)\n",
    "\n",
    "    print(f\"Western Province outlets: {len(western):,}\")\n",
    "    print(f\"Total budget: LKR {total_budget:,.0f}\")\n",
    "\n",
    "    # ── Potential gap (for Tier 1) ───────────────────────────────────────────\n",
    "    western['potential_gap'] = (\n",
    "        western['predicted_jan_2026_potential'] - western['observed_avg_monthly']\n",
    "    ).clip(lower=0)\n",
    "    total_gap = western['potential_gap'].sum()\n",
    "    western['roi_weight'] = western['potential_gap'] / (total_gap + 1e-9)\n",
    "\n",
    "    # ── Population weight (for Tier 2) ──────────────────────────────────────\n",
    "    # Uses poi_relative_density as a proxy for population density\n",
    "    # Higher poi density = more populated area = more footfall potential\n",
    "    if 'poi_relative_density' in western.columns:\n",
    "        pop_col = 'poi_relative_density'\n",
    "    elif 'competitor_density' in western.columns:\n",
    "        pop_col = 'competitor_density'\n",
    "    elif 'avg_sku_breadth' in western.columns:\n",
    "        pop_col = 'avg_sku_breadth'\n",
    "    else:\n",
    "        pop_col = 'predicted_jan_2026_potential'\n",
    "    print(f\"  Using '{pop_col}' as population proxy\")\n",
    "    pop_total = western[pop_col].sum()\n",
    "    western['population_weight'] = western[pop_col] / (pop_total + 1e-9)\n",
    "\n",
    "    # ── Seasonality weight (for Tier 3) ─────────────────────────────────────\n",
    "    # Uses jan_seasonality_score — high score = outlet spikes during holidays\n",
    "    season_total = western['jan_seasonality_score'].sum()\n",
    "    western['seasonality_weight'] = western['jan_seasonality_score'] / (season_total + 1e-9)\n",
    "\n",
    "    # ── Tier definitions ─────────────────────────────────────────────────────\n",
    "    # Tier 1 (60%): outlets with highest potential gap\n",
    "    tier1 = western[western['potential_gap'] > western['potential_gap'].quantile(0.4)].copy()\n",
    "\n",
    "    # Tier 2 (20%): outlets in high population areas not already in Tier 1\n",
    "    remaining = western[~western['Outlet_ID'].isin(tier1['Outlet_ID'])].copy()\n",
    "    tier2 = remaining[\n",
    "        remaining[pop_col] > remaining[pop_col].quantile(0.5)\n",
    "    ].copy()\n",
    "\n",
    "    # Tier 3 (20%): outlets with high seasonality not in Tier 1 or 2\n",
    "    remaining2 = western[~western['Outlet_ID'].isin(\n",
    "        pd.concat([tier1, tier2])['Outlet_ID']\n",
    "    )].copy()\n",
    "    tier3 = remaining2[\n",
    "        remaining2['jan_seasonality_score'] > remaining2['jan_seasonality_score'].quantile(0.3)\n",
    "    ].copy()\n",
    "\n",
    "    print(f\"\\nTier 1 (high potential gap)   60% budget: {len(tier1):,} outlets\")\n",
    "    print(f\"Tier 2 (high population)      20% budget: {len(tier2):,} outlets\")\n",
    "    print(f\"Tier 3 (high seasonality)     20% budget: {len(tier3):,} outlets\")\n",
    "\n",
    "    def allocate_tier(tier_df, weight_col, budget, max_per_outlet):\n",
    "        if len(tier_df) == 0 or tier_df[weight_col].sum() == 0:\n",
    "            return pd.Series(0.0, index=tier_df.index)\n",
    "        raw = tier_df[weight_col] / tier_df[weight_col].sum() * budget\n",
    "        capped = raw.clip(upper=max_per_outlet)\n",
    "        excess = raw.sum() - capped.sum()\n",
    "        if excess > 1 and (capped < max_per_outlet).any():\n",
    "            not_maxed = capped < max_per_outlet\n",
    "            capped[not_maxed] += (\n",
    "                excess * (tier_df.loc[not_maxed, weight_col] /\n",
    "                          tier_df.loc[not_maxed, weight_col].sum())\n",
    "            ).clip(upper=max_per_outlet - capped[not_maxed])\n",
    "        return capped\n",
    "\n",
    "    alloc_t1 = allocate_tier(tier1, 'roi_weight',          total_budget * 0.60, max_spend)\n",
    "    alloc_t2 = allocate_tier(tier2, 'population_weight',   total_budget * 0.20, max_spend * 0.5)\n",
    "    alloc_t3 = allocate_tier(tier3, 'seasonality_weight',  total_budget * 0.20, max_spend * 0.5)\n",
    "\n",
    "    all_alloc = pd.concat([alloc_t1, alloc_t2, alloc_t3])\n",
    "    western['trade_spend_lkr'] = western.index.map(all_alloc.to_dict()).fillna(0)\n",
    "    western['trade_spend_lkr'] = (western['trade_spend_lkr'] / 100).round() * 100\n",
    "    western['estimated_volume_uplift'] = (\n",
    "        western['trade_spend_lkr'] / 1000 * 0.01 * western['predicted_jan_2026_potential']\n",
    "    ).round(1)\n",
    "\n",
    "    western['budget_tier'] = 'No Spend'\n",
    "    western.loc[western['Outlet_ID'].isin(tier1['Outlet_ID']), 'budget_tier'] = 'Tier 1 - High Potential'\n",
    "    western.loc[western['Outlet_ID'].isin(tier2['Outlet_ID']), 'budget_tier'] = 'Tier 2 - High Population'\n",
    "    western.loc[western['Outlet_ID'].isin(tier3['Outlet_ID']), 'budget_tier'] = 'Tier 3 - High Seasonality'\n",
    "\n",
    "    print(f\"\\n{'─'*60}\")\n",
    "    print(f\"Total allocated:          LKR {western['trade_spend_lkr'].sum():>12,.0f}\")\n",
    "    print(f\"Total est. volume uplift: {western['estimated_volume_uplift'].sum():>12,.0f} L\")\n",
    "    cost_per_l = western['trade_spend_lkr'].sum() / (western['estimated_volume_uplift'].sum() + 1)\n",
    "    print(f\"Cost per liter uplift:    LKR {cost_per_l:>12,.0f}\")\n",
    "\n",
    "    budget_out = western[['Outlet_ID', 'trade_spend_lkr', 'budget_tier']].rename(\n",
    "        columns={'trade_spend_lkr': 'Trade_Spend_Allocation_LKR', 'budget_tier': 'Budget_Tier'}\n",
    "    )\n",
    "    budget_out.to_csv('output/Data_Drifters_budget_allocations.csv', index=False)\n",
    "    print(f\"\\n✓ Saved: output/Data_Drifters_budget_allocations.csv\")\n",
    "\n",
    "    return western\n",
    "\n",
    "\n",
    "# ── Load Distributor_ID from gold ────────────────────────────────────────────\n",
    "distributor_map = pd.read_csv('gold/outlet_features.csv')[['Outlet_ID', 'Distributor_ID']]\n",
    "print(f\"Distributor map loaded: {len(distributor_map):,} outlets\")\n",
    "print(f\"Distributors found: {sorted(distributor_map['Distributor_ID'].unique())}\")\n",
    "\n",
    "# ── Run optimizer ─────────────────────────────────────────────────────────────\n",
    "budget_results = optimize_marketing_budget(\n",
    "    predictions_df=output,\n",
    "    outlet_master_df=distributor_map,\n",
    "    total_budget=5_000_000,\n",
    "    max_spend=200_000,\n",
    ")\n",
    "\n",
    "# ── Summary ───────────────────────────────────────────────────────────────────\n",
    "print(f\"\\n{'='*60}\")\n",
    "print(\"SUMMARY\")\n",
    "print(f\"{'='*60}\")\n",
    "print(f\"Outlets receiving spend:  {(budget_results['trade_spend_lkr'] > 0).sum():,}\")\n",
    "print(f\"Outlets with zero spend:  {(budget_results['trade_spend_lkr'] == 0).sum():,}\")\n",
    "\n",
    "print(f\"\\nSpend by Tier:\")\n",
    "print(\n",
    "    budget_results.groupby('budget_tier')['trade_spend_lkr']\n",
    "    .agg(['sum', 'mean', 'count'])\n",
    "    .rename(columns={'sum': 'Total LKR', 'mean': 'Avg LKR', 'count': 'Outlets'})\n",
    "    .round(0)\n",
    ")\n",
    "\n",
    "print(f\"\\nSpend by Distributor:\")\n",
    "print(\n",
    "    budget_results.groupby('Distributor_ID')['trade_spend_lkr']\n",
    "    .agg(['sum', 'mean', 'count'])\n",
    "    .rename(columns={'sum': 'Total LKR', 'mean': 'Avg LKR', 'count': 'Outlets'})\n",
    "    .round(0)\n",
    ")"
   ]
  },
