    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# POI ENRICHMENT — Step 3 (IMPROVED): Distance-Decay Spatial Scoring\n",
    "#\n",
    "# REPLACES the original flat BallTree count cell (Step 3).\n",
    "# REPLACES the compute_competitor_density() function cell (Step 4).\n",
    "#\n",
    "# What changed and why:\n",
    "#   OLD: poi_{cat}_count = flat headcount within a fixed radius\n",
    "#        → treats a bus stop 20 m away the same as one at 480 m\n",
    "#   NEW: poi_{cat}_decay_score = weighted sum using THREE decay functions\n",
    "#        → closer POIs have exponentially larger influence\n",
    "#\n",
    "#   Three methods, then ensemble-averaged:\n",
    "#   1. Gaussian decay    : w = exp(-d² / 2σ²)         σ = 150 m urban / 350 m rural\n",
    "#   2. Exponential decay : w = exp(-d / λ)             λ = 200 m urban / 500 m rural\n",
    "#   3. Gravity model     : w = 1 / (1 + d/d0)^β       d0=100/250 m, β=2.0\n",
    "#\n",
    "#   Averaging the three methods reduces sensitivity to bandwidth choice.\n",
    "#   Urban/rural bandwidths are differentiated because Western Province outlets\n",
    "#   (DIST_W_*) have a 500 m search radius whereas other provinces use 1000 m.\n",
    "#\n",
    "# New Gold columns produced:\n",
    "#   poi_{cat}_gaussian_score   — Gaussian-weighted POI mass per category\n",
    "#   poi_{cat}_exp_score        — Exponential-weighted POI mass per category\n",
    "#   poi_{cat}_gravity_score    — Gravity-model-weighted POI mass per category\n",
    "#   poi_{cat}_decay_score      — Ensemble (0-1 normalised avg) ← use in model\n",
    "#   nearest_{cat}_m            — Unchanged: distance to nearest POI in metres\n",
    "#   poi_total_decay_score      — Sum of ensemble scores across all categories\n",
    "#   competitor_gaussian_score  — Gaussian competitor mass\n",
    "#   competitor_exp_score       — Exponential competitor mass\n",
    "#   competitor_gravity_score   — Gravity competitor mass\n",
    "#   competitor_density         — Ensemble competitor score ← replaces old column\n",
    "#   market_saturation          — competitor_density / (poi_total_decay_score+ε)\n",
    "#   poi_relative_decay_density — poi_total / (competitor_density+1)  ← replaces poi_relative_density\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "print(f\"\\n{'='*70}\")\n",
    "print(\"POI ENRICHMENT — Step 3 (IMPROVED): Distance-Decay Spatial Scoring\")\n",
    "print(f\"{'='*70}\")\n",
    "\n",
    "import numpy as np\n",
    "from sklearn.neighbors import BallTree\n",
    "\n",
    "EARTH_RADIUS_M = 6_371_000\n",
    "\n",
    "# ── Bandwidth parameters ──────────────────────────────────────────────────────\n",
    "# Urban = Western Province (DIST_W_*, 500 m search radius)\n",
    "# Rural = all other provinces             (1000 m search radius)\n",
    "#\n",
    "# Gaussian σ:  1-sigma ≈ 1/3 of the typical inter-POI spacing in each zone\n",
    "SIGMA_URBAN_M  = 150\n",
    "SIGMA_RURAL_M  = 350\n",
    "\n",
    "# Exponential λ: influence halves every λ metres\n",
    "LAMBDA_URBAN_M = 200\n",
    "LAMBDA_RURAL_M = 500\n",
    "\n",
    "# Gravity d0: reference distance for unit weight; β = standard retail gravity\n",
    "D0_URBAN_M   = 100\n",
    "D0_RURAL_M   = 250\n",
    "GRAVITY_BETA = 2.0\n",
    "\n",
    "print(f\"  Bandwidth parameters:\")\n",
    "print(f\"    Gaussian  σ  — urban: {SIGMA_URBAN_M} m   rural: {SIGMA_RURAL_M} m\")\n",
    "print(f\"    Exp       λ  — urban: {LAMBDA_URBAN_M} m  rural: {LAMBDA_RURAL_M} m\")\n",
    "print(f\"    Gravity   d0 — urban: {D0_URBAN_M} m   rural: {D0_RURAL_M} m  β={GRAVITY_BETA}\")\n",
    "\n",
    "\n",
    "# ── Decay functions ───────────────────────────────────────────────────────────\n",
    "\n",
    "def gaussian_decay(distances_m, sigma):\n",
    "    \"\"\"w_i = exp(−d_i² / 2σ²).  Rapid drop-off; good for dense urban POIs.\"\"\"\n",
    "    return np.exp(-(distances_m ** 2) / (2.0 * sigma ** 2))\n",
    "\n",
    "\n",
    "def exponential_decay(distances_m, lam):\n",
    "    \"\"\"w_i = exp(−d_i / λ).  Steady geometric falloff; models corridor demand.\"\"\"\n",
    "    return np.exp(-distances_m / lam)\n",
    "\n",
    "\n",
    "def gravity_decay(distances_m, d0, beta):\n",
    "    \"\"\"w_i = 1 / (1 + d_i/d0)^β.  Power-law; softer long-range tail.\n",
    "    β=2 matches the classic Reilly retail gravity model.\"\"\"\n",
    "    return 1.0 / (1.0 + distances_m / d0) ** beta\n",
    "\n",
    "\n",
    "def _normalise(arr):\n",
    "    \"\"\"Min-max scale an array to [0, 1].  Returns zeros if all values equal.\"\"\"\n",
    "    lo, hi = arr.min(), arr.max()\n",
    "    return (arr - lo) / (hi - lo) if hi > lo else np.zeros_like(arr)\n",
    "\n",
    "\n",
    "# ── Setup: outlets with valid coordinates ─────────────────────────────────────\n",
    "has_coords_mask = gold['has_coords'] == 1\n",
    "outlets_wc      = gold[has_coords_mask].copy().reset_index(drop=True)\n",
    "n_outlets       = len(outlets_wc)\n",
    "print(f\"\\n  Outlets with coordinates: {n_outlets:,}\")\n",
    "\n",
    "outlet_coords_rad = np.deg2rad(outlets_wc[['Latitude', 'Longitude']].values)\n",
    "\n",
    "# Per-outlet bandwidth vectors (urban vs rural)\n",
    "is_urban   = outlets_wc['Distributor_ID'].str.startswith('DIST_W').fillna(False).values\n",
    "sigma_arr  = np.where(is_urban, SIGMA_URBAN_M,  SIGMA_RURAL_M).astype(float)\n",
    "lambda_arr = np.where(is_urban, LAMBDA_URBAN_M, LAMBDA_RURAL_M).astype(float)\n",
    "d0_arr     = np.where(is_urban, D0_URBAN_M,     D0_RURAL_M).astype(float)\n",
    "radius_arr = outlets_wc['radius_m'].values.astype(float)   # 500 or 1000 m\n",
    "\n",
    "# Global maximum radius for the single BallTree sweep\n",
    "max_radius_rad = radius_arr.max() / EARTH_RADIUS_M\n",
    "\n",
    "\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# PART A: POI decay scores (one loop per category)\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "categories = poi_df['category'].unique().tolist() if len(poi_df) > 0 else []\n",
    "\n",
    "for cat in categories:\n",
    "    cat_pois = poi_df[poi_df['category'] == cat].reset_index(drop=True)\n",
    "\n",
    "    if len(cat_pois) == 0:\n",
    "        for sfx in ('gaussian_score', 'exp_score', 'gravity_score', 'decay_score'):\n",
    "            gold.loc[has_coords_mask, f'poi_{cat}_{sfx}'] = 0.0\n",
    "        gold.loc[has_coords_mask, f'nearest_{cat}_m'] = np.nan\n",
    "        continue\n",
    "\n",
    "    poi_coords_rad = np.deg2rad(cat_pois[['lat', 'lon']].values)\n",
    "    tree = BallTree(poi_coords_rad, metric='haversine')\n",
    "\n",
    "    # One bulk query at the global maximum radius — then filter per outlet below.\n",
    "    # This is much faster than one query per outlet.\n",
    "    dists_rad_list, _ = tree.query_radius(\n",
    "        outlet_coords_rad,\n",
    "        r=max_radius_rad,\n",
    "        return_distance=True,\n",
    "        sort_results=True    # ascending — so [0] is nearest\n",
    "    )\n",
    "\n",
    "    gauss_scores   = np.zeros(n_outlets)\n",
    "    exp_scores     = np.zeros(n_outlets)\n",
    "    gravity_scores = np.zeros(n_outlets)\n",
    "    nearest_m_arr  = np.full(n_outlets, np.nan)\n",
    "\n",
    "    for i, d_rad in enumerate(dists_rad_list):\n",
    "        if len(d_rad) == 0:\n",
    "            continue\n",
    "\n",
    "        d_m = d_rad * EARTH_RADIUS_M\n",
    "\n",
    "        # Record nearest regardless of per-outlet radius\n",
    "        nearest_m_arr[i] = d_m[0]\n",
    "\n",
    "        # Trim to this outlet's search radius, then score\n",
    "        d_within = d_m[d_m <= radius_arr[i]]\n",
    "        if len(d_within) == 0:\n",
    "            continue\n",
    "\n",
    "        gauss_scores[i]   = gaussian_decay(d_within,  sigma_arr[i]).sum()\n",
    "        exp_scores[i]     = exponential_decay(d_within, lambda_arr[i]).sum()\n",
    "        gravity_scores[i] = gravity_decay(d_within, d0_arr[i], GRAVITY_BETA).sum()\n",
    "\n",
    "    # Normalise each method to [0,1] then average → ensemble score\n",
    "    ensemble_scores = (\n",
    "        _normalise(gauss_scores) + _normalise(exp_scores) + _normalise(gravity_scores)\n",
    "    ) / 3.0\n",
    "\n",
    "    gold.loc[has_coords_mask, f'poi_{cat}_gaussian_score'] = gauss_scores\n",
    "    gold.loc[has_coords_mask, f'poi_{cat}_exp_score']      = exp_scores\n",
    "    gold.loc[has_coords_mask, f'poi_{cat}_gravity_score']  = gravity_scores\n",
    "    gold.loc[has_coords_mask, f'poi_{cat}_decay_score']    = ensemble_scores\n",
    "    gold.loc[has_coords_mask, f'nearest_{cat}_m']          = nearest_m_arr\n",
    "\n",
    "    print(\n",
    "        f\"  ✓ {cat:12s}  \"\n",
    "        f\"n_pois={len(cat_pois):,}  \"\n",
    "        f\"gauss={gauss_scores.mean():.3f}  \"\n",
    "        f\"exp={exp_scores.mean():.3f}  \"\n",
    "        f\"grav={gravity_scores.mean():.3f}  \"\n",
    "        f\"ensemble={ensemble_scores.mean():.3f}\"\n",
    "    )\n",
    "\n",
    "# Composite total decay score (sum across categories — unnormalised sum is fine\n",
    "# here because it's an additive demand signal).\n",
    "decay_score_cols = [c for c in gold.columns if c.endswith('_decay_score')]\n",
    "gold['poi_total_decay_score'] = gold[decay_score_cols].sum(axis=1)\n",
    "\n",
    "# Keep legacy flat count column so downstream cells that reference poi_total_count\n",
    "# still work without modification.\n",
    "count_cols = [c for c in gold.columns if c.startswith('poi_') and c.endswith('_count')]\n",
    "if count_cols:\n",
    "    gold['poi_total_count'] = gold[count_cols].sum(axis=1)\n",
    "\n",
    "# Zero-fill outlets without coordinates\n",
    "poi_fill_cols = [c for c in gold.columns if c.startswith('poi_') or c.startswith('nearest_')]\n",
    "gold[poi_fill_cols] = gold[poi_fill_cols].fillna(0)\n",
    "\n",
    "print(f\"\\n  poi_total_decay_score — \"\n",
    "      f\"median: {gold['poi_total_decay_score'].median():.3f}  \"\n",
    "      f\"mean: {gold['poi_total_decay_score'].mean():.3f}  \"\n",
    "      f\"max: {gold['poi_total_decay_score'].max():.3f}\")\n",
    "\n",
    "\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "# PART B: Competitive Catchment Density (replaces compute_competitor_density)\n",
    "#\n",
    "# Why this is better than the old version:\n",
    "#   OLD: single Gaussian with hardcoded 500 m bandwidth for all provinces;\n",
    "#        outlet-level loop (slow); produces one score.\n",
    "#   NEW: three decay functions, province-aware bandwidths, vectorised bulk query;\n",
    "#        produces an ensemble score + market_saturation index.\n",
    "# ══════════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "print(f\"\\n{'='*70}\")\n",
    "print(\"POI ENRICHMENT — Step 4 (IMPROVED): Competitive Catchment Density\")\n",
    "print(f\"{'='*70}\")\n",
    "\n",
    "outlet_tree = BallTree(outlet_coords_rad, metric='haversine')\n",
    "\n",
    "comp_dists_list, _ = outlet_tree.query_radius(\n",
    "    outlet_coords_rad,\n",
    "    r=max_radius_rad,\n",
    "    return_distance=True,\n",
    "    sort_results=True\n",
    ")\n",
    "\n",
    "comp_gauss   = np.zeros(n_outlets)\n",
    "comp_exp     = np.zeros(n_outlets)\n",
    "comp_gravity = np.zeros(n_outlets)\n",
    "nearby_count = np.zeros(n_outlets, dtype=int)\n",
    "\n",
    "for i, d_rad in enumerate(comp_dists_list):\n",
    "    if len(d_rad) == 0:\n",
    "        continue\n",
    "\n",
    "    d_m = d_rad * EARTH_RADIUS_M\n",
    "\n",
    "    # Exclude the outlet itself (d=0) and anything beyond its search radius\n",
    "    rivals = (d_m > 0) & (d_m <= radius_arr[i])\n",
    "    d_rivals = d_m[rivals]\n",
    "\n",
    "    nearby_count[i] = rivals.sum()   # flat count for backward compatibility\n",
    "\n",
    "    if len(d_rivals) == 0:\n",
    "        continue\n",
    "\n",
    "    comp_gauss[i]   = gaussian_decay(d_rivals,  sigma_arr[i]).sum()\n",
    "    comp_exp[i]     = exponential_decay(d_rivals, lambda_arr[i]).sum()\n",
    "    comp_gravity[i] = gravity_decay(d_rivals, d0_arr[i], GRAVITY_BETA).sum()\n",
    "\n",
    "comp_ensemble = (\n",
    "    _normalise(comp_gauss) + _normalise(comp_exp) + _normalise(comp_gravity)\n",
    ") / 3.0\n",
    "\n",
    "gold.loc[has_coords_mask, 'competitor_gaussian_score'] = comp_gauss\n",
    "gold.loc[has_coords_mask, 'competitor_exp_score']      = comp_exp\n",
    "gold.loc[has_coords_mask, 'competitor_gravity_score']  = comp_gravity\n",
    "gold.loc[has_coords_mask, 'competitor_density']        = comp_ensemble   # ← same column name as before\n",
    "gold.loc[has_coords_mask, 'nearby_outlet_count']       = nearby_count    # ← flat count preserved\n",
    "\n",
    "comp_fill_cols = ['competitor_gaussian_score', 'competitor_exp_score',\n",
    "                  'competitor_gravity_score', 'competitor_density',\n",
    "                  'nearby_outlet_count']\n",
    "gold[comp_fill_cols] = gold[comp_fill_cols].fillna(0)\n",
    "\n",
    "# Market saturation: high value = crowded market, low POI demand relative to rivals\n",
    "eps = 1e-6\n",
    "gold['market_saturation'] = (\n",
    "    gold['competitor_density'] / (gold['poi_total_decay_score'] + eps)\n",
    ").round(4)\n",
    "\n",
    "# poi_relative_decay_density replaces the old poi_relative_density.\n",
    "# The original column name is also aliased so existing model code doesn't break.\n",
    "gold['poi_relative_decay_density'] = (\n",
    "    gold['poi_total_decay_score'] / (gold['competitor_density'] + 1)\n",
    ").round(4)\n",
    "gold['poi_relative_density'] = gold['poi_relative_decay_density']   # alias for model compatibility\n",
    "\n",
    "print(f\"  competitor_density         — \"\n",
    "      f\"median: {gold['competitor_density'].median():.3f}  \"\n",
    "      f\"max: {gold['competitor_density'].max():.3f}\")\n",
    "print(f\"  market_saturation          — \"\n",
    "      f\"median: {gold['market_saturation'].median():.3f}  \"\n",
    "      f\"max: {gold['market_saturation'].max():.3f}\")\n",
    "print(f\"  poi_relative_decay_density — \"\n",
    "      f\"median: {gold['poi_relative_decay_density'].median():.3f}\")\n",
    "\n",
    "# ── Sanity check: urban outlets should have higher competitor density ─────────\n",
    "western_mask = gold['Distributor_ID'].str.startswith('DIST_W').fillna(False)\n",
    "urban_med  = gold.loc[western_mask,  'competitor_density'].median()\n",
    "rural_med  = gold.loc[~western_mask, 'competitor_density'].median()\n",
    "print(f\"\\n  Competitor density sanity check:\")\n",
    "print(f\"    Western (urban) median: {urban_med:.3f}\")\n",
    "print(f\"    Other   (rural) median: {rural_med:.3f}\")\n",
    "if urban_med > rural_med:\n",
    "    print(f\"    ✓ Urban > Rural — decay correctly captures market structure\")\n",
    "else:\n",
    "    print(f\"    ⚠ Unexpected: rural ≥ urban — check coordinate coverage\")\n",
    "\n",
    "# ── Save updated Gold table ────────────────────────────────────────────────────\n",
    "gold.to_pickle(f\"{DATA_PATHS['gold']}outlet_features.pkl\")\n",
    "gold.to_csv(f\"{DATA_PATHS['gold']}outlet_features.csv\", index=False)\n",
    "\n",
    "new_feature_count = len(decay_score_cols) + len(comp_fill_cols) + 3   # +market_sat +rel_density +alias\n",
    "print(f\"\\n  ✓ Gold table saved — {new_feature_count} new decay features\")\n",
    "print(f\"  Shape: {gold.shape[0]:,} outlets × {gold.shape[1]} features\")\n",
    "print(f\"  File:  gold/outlet_features.pkl\")"
   ]
  },
